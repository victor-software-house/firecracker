+
+/// The most runs of holes a restore maps anonymously. Each one can add two mappings, which count
+/// against `vm.max_map_count` (65530 by default) along with the ones later discards create, so a
+/// fragmented memory file gets the largest runs mapped anonymously and the rest left file-backed.
+const MAX_ANONYMOUS_HOLES: usize = 1024;
+
+/// Replaces the mapping of up to `max_runs` of the largest 2 MiB-aligned runs of holes in `file`
+/// with anonymous memory advised for transparent huge pages. `regions` lie back to back in the
+/// file, each mapped at the matching entry of `host_bases`.
+fn map_holes_anonymously(
+    file: &File,
+    regions: &[(GuestAddress, usize)],
+    host_bases: &[u64],
+    max_runs: usize,
+) -> Result<(), MemoryError> {
+    const HUGE_PAGE: u64 = 2 << 20;
+    let metadata = file.metadata().map_err(MemoryError::SeekHole)?;
+    // A file with a block allocated for every byte has no holes. Checking that first keeps a
+    // dense file free, where on tmpfs even one SEEK_HOLE scans the whole page cache.
+    if metadata.blocks() * 512 >= metadata.size() {
+        return Ok(());
+    }
+    let seek = |at: u64, whence: libc::c_int| -> Result<Option<u64>, MemoryError> {
+        let at = i64::try_from(at).map_err(|_| MemoryError::OffsetTooLarge)?;
+        // SAFETY: lseek on a descriptor owned by `file`.
+        let ret = unsafe { libc::lseek(file.as_raw_fd(), at, whence) };
+        if ret >= 0 {
+            return Ok(Some(ret.cast_unsigned()));
+        }
+        let err = io::Error::last_os_error();
+        // ENXIO: no hole or data after `at`.
+        if err.raw_os_error() == Some(libc::ENXIO) {
+            Ok(None)
+        } else {
+            Err(MemoryError::SeekHole(err))
+        }
+    };
+    let end: u64 = regions.iter().map(|&(_, size)| size as u64).sum();
+    let mut runs = Vec::new();
+    let mut pos = 0;
+    while pos < end {
+        let Some(hole) = seek(pos, libc::SEEK_HOLE)? else {
+            break;
+        };
+        if hole >= end {
+            break;
+        }
+        let data = seek(hole, libc::SEEK_DATA)?.map_or(end, |data| data.min(end));
+        // A run of holes can cross from one region into the next.
+        let mut offset = 0;
+        for (&(_, size), &host_base) in regions.iter().zip(host_bases) {
+            let (lo, hi) = (hole.max(offset), data.min(offset + size as u64));
+            if lo < hi {
+                let start = align_up!(host_base + (lo - offset), HUGE_PAGE);
+                let stop = align_down!(host_base + (hi - offset), HUGE_PAGE);
+                if start < stop {
+                    runs.push((start, stop - start));
+                }
+            }
+            offset += size as u64;
+        }
+        pos = data;
+    }
+    runs.sort_unstable_by_key(|&(_, len)| std::cmp::Reverse(len));
+    for &(start, len) in runs.iter().take(max_runs) {
+        let len = u64_to_usize(len);
+        // SAFETY: the range lies inside a region mapping created by the caller, and MAP_FIXED
+        // replaces exactly that range, with the flags the region was created with.
+        let ret = unsafe {
+            libc::mmap(
+                start as *mut c_void,
+                len,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_FIXED | libc::MAP_ANONYMOUS | libc::MAP_PRIVATE | libc::MAP_NORESERVE,
+                -1,
+                0,
+            )
+        };
+        if ret == libc::MAP_FAILED {
+            return Err(MemoryError::RemapHole(io::Error::last_os_error()));
+        }
+        // SAFETY: the range was mapped just above.
+        if unsafe { libc::madvise(start as *mut c_void, len, libc::MADV_HUGEPAGE) } != 0 {
+            return Err(MemoryError::Madvise(io::Error::last_os_error()));
+        }
+    }
+    Ok(())
 }
 
